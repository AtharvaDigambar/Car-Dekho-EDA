SELECT
    e.event_name,
    a.athlete_name,
    r.finish_time,
    ROUND(
        AVG(r.finish_time) OVER (PARTITION BY r.event_id),
        2
    ) AS avg_event_time
FROM Results r
JOIN Events e
    ON r.event_id = e.event_id
JOIN Athletes a
    ON r.athlete_id = a.athlete_id
WHERE r.status = 'Recorded'
ORDER BY
    e.event_name,
    r.finish_time,
    a.athlete_name;
