from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.functions import (
    col,
    trim,
    min,
    max,
    avg,
    count,
    desc,
    asc
)
from pyspark.sql.types import IntegerType


def load_feedback_data(spark: SparkSession, path: str) -> DataFrame:
    return (
        spark.read
        .option("header", True)
        .option("inferSchema", True)
        .csv(path)
    )


def clean_missing_and_invalid_emails(df: DataFrame) -> DataFrame:
    return df.filter(
        col("email").isNotNull() &
        (trim(col("email")) != "")
    )


def compute_rating_stats(df: DataFrame) -> dict:
    df = df.withColumn(
        "rating",
        col("rating").cast(IntegerType())
    )

    df = df.filter(col("rating").isNotNull())

    result = (
        df.agg(
            min("rating").alias("min_rating"),
            max("rating").alias("max_rating"),
            avg("rating").alias("avg_rating")
        )
        .collect()[0]
    )

    return {
        "min_rating": result["min_rating"],
        "max_rating": result["max_rating"],
        "avg_rating": result["avg_rating"]
    }


def count_ratings(df: DataFrame) -> int:
    return df.filter(
        col("rating").isNotNull()
    ).count()



def most_common_rating(df: DataFrame) -> int:
    df = df.withColumn(
        "rating",
        col("rating").cast(IntegerType())
    )

    df = df.filter(
        col("rating").isNotNull() &
        col("rating").between(1, 5)
    )

    result = (
        df.groupBy("rating")
        .count()
        .orderBy(
            desc("count"),
            asc("rating")
        )
        .first()
    )

    if result is None:
        return 0

    return result["rating"]


spark = (
    SparkSession.builder
    .appName("CustomerFeedbackInsights")
    .master("local[*]")
    .getOrCreate()
)


path = "data/feedback.csv"

df = load_feedback_data(spark, path)

df.show()

cleaned_df = clean_missing_and_invalid_emails(df)

stats = compute_rating_stats(cleaned_df)

total_ratings = count_ratings(cleaned_df)

common_rating = most_common_rating(cleaned_df)

print("Cleaned Data:")
cleaned_df.show()

print("Rating Statistics:")
print(stats)

print("Total Valid Ratings:")
print(total_ratings)

print("Most Common Rating:")
print(common_rating)
