-- =========================================
-- Required Report Query
-- =========================================

SELECT
    b.booking_id,
    b.booking_date,
    b.status,
    g.name AS guest_name,
    r.room_number,
    s.section_name
FROM Bookings b
JOIN Guests g
    ON b.guest_id = g.guest_id
JOIN Rooms r
    ON b.room_id = r.room_id
JOIN Sections s
    ON r.section_id = s.section_id;
