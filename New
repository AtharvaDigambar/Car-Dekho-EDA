class WarehouseStockManager:

    def __init__(self):
        self.stock = {}

    # 1. Register a New Item
    def register_item(self, item_name: str, quantity: int) -> dict:
        if item_name in self.stock:
            self.stock[item_name] += quantity
        else:
            self.stock[item_name] = quantity

        return self.stock

    # 2. Process Bulk Shipment
    def process_shipment(self, shipment: dict) -> dict:
        for item, quantity in shipment.items():

            # Item exists and has enough stock
            if item in self.stock and isinstance(self.stock[item], int):
                if self.stock[item] >= quantity:
                    self.stock[item] -= quantity

                    # If stock becomes zero
                    if self.stock[item] == 0:
                        self.stock[item] = "Out of Stock"
                else:
                    self.stock[item] = "Out of Stock"

            # Item does not exist
            else:
                self.stock[item] = "Out of Stock"

        return self.stock

    # 3. Restock Sold-Out Items
    def restock_items(self, restock_quantity: int) -> dict:
        for item in self.stock:
            if self.stock[item] == "Out of Stock":
                self.stock[item] = restock_quantity

        return self.stock

    # 4. Generate Low Stock Report
    def generate_low_stock_report(self, threshold: int) -> dict:
        low_stock = {}

        for item, quantity in self.stock.items():
            if isinstance(quantity, int) and quantity < threshold:
                low_stock[item] = quantity

        return low_stock
