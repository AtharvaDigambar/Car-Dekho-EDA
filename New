from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.functions import col, coalesce, concat_ws
from pyspark.sql.types import IntegerType


# 1. Load Employee and Performance Data
def load_employee_data(
    spark: SparkSession,
    path1: str,
    path2: str
) -> tuple[DataFrame, DataFrame]:

    employees_df = (
        spark.read
        .option("header", True)
        .option("inferSchema", True)
        .csv(path1)
    )

    performance_df = (
        spark.read
        .option("header", True)
        .option("inferSchema", True)
        .csv(path2)
    )

    # Ensure employee_id is IntegerType
    employees_df = employees_df.withColumn(
        "employee_id",
        col("employee_id").cast(IntegerType())
    )

    performance_df = performance_df.withColumn(
        "employee_id",
        col("employee_id").cast(IntegerType())
    )

    return employees_df, performance_df


# 2. Join Employee and Performance Data
def join_employee_data(
    df1: DataFrame,
    df2: DataFrame
) -> DataFrame:

    joined_df = df1.join(
        df2,
        on="employee_id",
        how="inner"
    )

    return joined_df


# 3. Enrich Missing Employee Names
def enrich_employee_name(df: DataFrame) -> DataFrame:

    df = df.withColumn(
        "full_name",
        coalesce(
            col("full_name"),
            concat_ws(" ", col("first_name"), col("last_name"))
        )
    )

    return df


# 4. Find Underperforming Employees
def find_underperforming_employees(df: DataFrame) -> DataFrame:

    result_df = (
        df.filter(col("rating") == "Poor")
          .select(
              "full_name",
              "department",
              "rating"
          )
    )

    return result_df
