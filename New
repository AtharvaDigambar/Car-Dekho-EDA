import numpy as np


# 1. Create Orders Array
def create_orders_array(orders_data: list) -> np.ndarray:
    return np.array(orders_data, dtype=np.int64)


# 2. Validate Orders Array
def validate_orders_array(orders_array: np.ndarray) -> bool:

    if orders_array.size == 0:
        return False

    if not np.issubdtype(orders_array.dtype, np.number):
        return False

    if np.any(orders_array < 0):
        return False

    return True


# 3. Compute Order Metrics
def compute_order_metrics(orders_array: np.ndarray) -> tuple:

    total = int(np.sum(orders_array))
    average = round(float(np.mean(orders_array)), 2)
    maximum = int(np.max(orders_array))

    return total, average, maximum


# 4. Categorize Order Volume Levels
def categorize_order_levels(orders_array: np.ndarray) -> np.ndarray:

    result = []

    for order in orders_array:
        if order < 300:
            result.append("Low Volume")
        elif order < 500:
            result.append("Moderate Volume")
        else:
            result.append("High Volume")

    return np.array(result)


# 5. Find Longest Growth Streak
def longest_order_growth_streak(orders_array: np.ndarray) -> int:

    if len(orders_array) == 0:
        return 0

    max_streak = 1
    current_streak = 1

    for i in range(1, len(orders_array)):

        if orders_array[i] > orders_array[i - 1]:
            current_streak += 1

            if current_streak > max_streak:
                max_streak = current_streak
        else:
            current_streak = 1

    return max_streak


# 6. Format Order Counts
def format_order_counts(orders_array: np.ndarray) -> np.ndarray:

    result = []

    for order in orders_array:
        result.append(f"{order:,}")

    return np.array(result)


# -------------------------------
# Test the functions
# -------------------------------

orders = create_orders_array([120, 360, 190, 540, 780])

print("Orders Array:", orders)

print("Validation:", validate_orders_array(orders))

print("Metrics:", compute_order_metrics(orders))

print("Order Levels:", categorize_order_levels(orders))

print("Longest Growth Streak:",
      longest_order_growth_streak(orders))

print("Formatted Orders:",
      format_order_counts(orders))
