from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.functions import col, coalesce, concat_ws
from pyspark.sql.types import IntegerType


# --------------------------------------------------
# 1. Load Employee and Performance Data
# --------------------------------------------------

def load_employee_data(spark: SparkSession, path1: str, path2: str):

    employees_df = (
        spark.read
        .csv(path1, header=True, inferSchema=True)
        .withColumn("employee_id", col("employee_id").cast(IntegerType()))
    )

    performance_df = (
        spark.read
        .csv(path2, header=True, inferSchema=True)
        .withColumn("employee_id", col("employee_id").cast(IntegerType()))
    )

    return employees_df, performance_df


# --------------------------------------------------
# 2. Join Employee and Performance Data
# --------------------------------------------------

def join_employee_data(df1: DataFrame, df2: DataFrame) -> DataFrame:

    joined_df = df1.join(
        df2,
        on="employee_id",
        how="inner"
    )

    return joined_df


# --------------------------------------------------
# 3. Enrich Missing Employee Names
# --------------------------------------------------

def enrich_employee_name(df: DataFrame) -> DataFrame:

    enriched_df = df.withColumn(
        "full_name",
        coalesce(
            col("full_name"),
            concat_ws(" ", col("first_name"), col("last_name"))
        )
    )

    return enriched_df


# --------------------------------------------------
# 4. Find Underperforming Employees
# --------------------------------------------------

def find_underperforming_employees(df: DataFrame) -> DataFrame:

    underperforming_df = (
        df.filter(col("rating") == "Poor")
          .select("full_name", "department", "rating")
    )

    return underperforming_df


# --------------------------------------------------
# Main Program
# --------------------------------------------------

spark = (
    SparkSession.builder
    .appName("Employee_Performance_Analysis")
    .master("local[*]")
    .getOrCreate()
)

# File paths
employees_path = "data/employees.csv"
performance_path = "data/performance.csv"

# 1. Load data
employees_df, performance_df = load_employee_data(
    spark,
    employees_path,
    performance_path
)

print("Employee Data:")
employees_df.show()

print("Performance Data:")
performance_df.show()


# 2. Join data
joined_df = join_employee_data(
    employees_df,
    performance_df
)

print("Joined Data:")
joined_df.show()


# 3. Enrich missing names
enriched_df = enrich_employee_name(joined_df)

print("Enriched Data:")
enriched_df.show()


# 4. Find underperforming employees
underperforming_df = find_underperforming_employees(enriched_df)

print("Underperforming Employees:")
underperforming_df.show()


spark.stop()
